# Keep imported React Native headers below Windows MAX_PATH without OS changes.
function(speseprofit_short_prefab)
  if(NOT DEFINED SPESEPROFIT_PREFAB_ROOT)
    set(SPESEPROFIT_PREFAB_ROOT "$ENV{SPESEPROFIT_PREFAB_ROOT}")
  endif()
  if(NOT DEFINED SPESEPROFIT_PREFAB_VERSION)
    set(SPESEPROFIT_PREFAB_VERSION "$ENV{SPESEPROFIT_PREFAB_VERSION}")
  endif()
  file(TO_CMAKE_PATH "${SPESEPROFIT_PREFAB_ROOT}" mirror)
  set(version "${SPESEPROFIT_PREFAB_VERSION}")
  if(NOT mirror OR NOT version)
    return()
  endif()
  get_property(imported DIRECTORY PROPERTY IMPORTED_TARGETS)
  foreach(target IN LISTS imported)
    foreach(property INTERFACE_INCLUDE_DIRECTORIES IMPORTED_LOCATION IMPORTED_LOCATION_DEBUG IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_RELWITHDEBINFO)
      get_target_property(paths "${target}" "${property}")
      if(NOT paths OR paths MATCHES "-NOTFOUND$")
        continue()
      endif()
      set(updated "")
      foreach(original IN LISTS paths)
        set(destination "${original}")
        foreach(variant debug release)
          set(marker "react-android-${version}-${variant}/prefab/")
          string(FIND "${original}" "${marker}" position)
          if(NOT position LESS 0)
            string(LENGTH "${marker}" marker_length)
            math(EXPR start "${position}+${marker_length}")
            string(SUBSTRING "${original}" ${start} -1 relative)
            set(destination "${mirror}/${variant}/${relative}")
            # Gradle may materialize the AAR only after task doFirst callbacks.
            # At CMake configure time the original prefab is already available.
            if(NOT EXISTS "${mirror}/${variant}/speseprofit-source.txt")
              string(SUBSTRING "${original}" 0 ${start} source_prefab)
              if(EXISTS "${source_prefab}/modules/reactnative/include")
                file(MAKE_DIRECTORY "${mirror}/${variant}")
                file(COPY "${source_prefab}/" DESTINATION "${mirror}/${variant}")
                file(WRITE "${mirror}/${variant}/speseprofit-source.txt" "${version}/${variant}")
              endif()
            endif()
            if(NOT EXISTS "${destination}")
              message(FATAL_ERROR "Missing verified local prefab: ${destination}")
            endif()
          endif()
        endforeach()
        list(APPEND updated "${destination}")
      endforeach()
      set_property(TARGET "${target}" PROPERTY "${property}" "${updated}")
    endforeach()
  endforeach()
endfunction()
cmake_language(DEFER CALL speseprofit_short_prefab)
